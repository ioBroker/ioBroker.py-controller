{
  "name": "iobroker.py-controller",
  "version": "0.1.1",
  "description": "Managed Python-Environments for Python-Adapter in ioBroker",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "build/main.js",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "ioBroker",
    "python",
    "venv",
    "uv"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.py-controller"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@iobroker/build-tools": "^3.0.1",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@iobroker/types": "^7.2.2",
    "@types/node": "^22.20.1",
    "mocha": "^12.0.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:gui",
    "test:package": "mocha test/package --exit --config test/mocharc.custom.json",
    "test:unit": "mocha test/check test/packages test/environments --exit --config test/mocharc.custom.json",
    "test:integration": "mocha test/integration --exit --config test/mocharc.custom.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint -c eslint.config.mjs",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i",
    "release": "release-script",
    "release-patch": "release-script patch --yes --publishAll",
    "release-minor": "release-script minor --yes --publishAll",
    "release-major": "release-script major --yes --publishAll",
    "test": "npm run build && npm run test:unit && npm run test:package",
    "build:gui": "tsx tasks.mts",
    "gui-0-clean": "tsx tasks.mts --0-clean",
    "gui-1-npm": "tsx tasks.mts --1-npm",
    "gui-2-build": "tsx tasks.mts --2-build",
    "gui-3-copy": "tsx tasks.mts --3-copy"
  },
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ]
}
