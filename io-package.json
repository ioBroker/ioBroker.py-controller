{
  "common": {
    "name": "py-controller",
    "version": "0.1.1",
    "titleLang": {
      "en": "Python Controller",
      "de": "Python Controller",
      "ru": "Python Controller",
      "pt": "Controlador Python",
      "nl": "Python Controller",
      "fr": "Contrôleur Python",
      "it": "Controller Python",
      "es": "Controlador de Python",
      "pl": "Kontroler Pythona",
      "zh-cn": "Python控制器"
    },
    "desc": {
      "en": "Manages Python environments for Python adapters",
      "de": "Verwaltet Python-Umgebungen für Python-Adapter",
      "ru": "Управляет средами Python для адаптеров Python",
      "pt": "Gerencia ambientes Python para adaptadores Python",
      "nl": "Beheert Python-omgevingen voor Python-adapters",
      "fr": "Gère les environnements Python pour les adaptateurs Python",
      "it": "Gestisce gli ambienti Python per gli adattatori Python",
      "es": "Gestiona entornos de Python para adaptadores de Python",
      "pl": "Zarządza środowiskami Pythona dla adapterów Pythona",
      "zh-cn": "管理Python适配器的Python环境"
    },
    "authors": [
      "bluefox <dogafox@gmail.com>"
    ],
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "enabled": false,
    "compact": false,
    "connectionType": "local",
    "dataSource": "assumption",
    "adminUI": {
      "config": "json"
    },
    "tier": 1,
    "keywords": [
      "python",
      "venv",
      "uv"
    ],
    "main": "build/main.js",
    "icon": "py-controller.svg",
    "materialize": true,
    "type": "general",
    "dependencies": [
      {
        "js-controller": ">7.2.2"
      }
    ],
    "news": {
      "0.1.1": {
        "en": "Added GUI widget for rebuilding the adapter's environment",
        "de": "GUI-Element zum Neubauen der Adapter-Umgebung hinzugefügt"
      },
      "0.1.0": {
        "en": "First working release: builds and rebuilds the virtual environment of every Python adapter with uv, reports each environment as states, removes the environment of an uninstalled adapter, and lets extra packages be requested through native.userPackages",
        "de": "Erste funktionsfähige Version: baut die virtuelle Umgebung jedes Python-Adapters mit uv auf und erneuert sie, meldet jede Umgebung als States, entfernt die Umgebung eines deinstallierten Adapters, und erlaubt zusätzliche Pakete über native.userPackages"
      },
      "0.0.1": {
        "en": "Initial skeleton",
        "de": "Erstes Gerüst"
      }
    },
    "supportedMessages": {
      "custom": true
    },
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "extIcon": "https://raw.githubusercontent.com/ioBroker/ioBroker.py-controller/main/admin/py-controller.svg"
  },
  "native": {
    "autoBuildEnvironments": true,
    "uvPath": "",
    "downloadUv": true,
    "editableInstall": "auto"
  },
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Bereit",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.installing",
      "type": "state",
      "common": {
        "role": "indicator.working",
        "name": "An environment is being built",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.installStatus",
      "type": "state",
      "common": {
        "role": "text",
        "name": "What is being installed",
        "type": "string",
        "read": true,
        "write": false,
        "def": ""
      },
      "native": {}
    }
  ]
}
